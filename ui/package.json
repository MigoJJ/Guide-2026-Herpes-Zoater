{
  "name": "herpes-zoster-emr-ui",
  "private": true,
  "version": "0.1.0",
  "description": "대상포진(Herpes Zoster) 임상 진료 지원 및 EMR 표준 차팅 자동 생성 시스템",
  "author": "고재준 (지디스내과)",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "share": "concurrently -n \"vite,tunnel\" -c \"blue,green\" \"vite --host\" \"sleep 2 && npx localtunnel --port 5173\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "immer": "^10.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.6",
    "jsdom": "^26.0.0",
    "oxlint": "^1.88.0",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
